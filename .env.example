# Base URL used for metadata (Open Graph, canonical URLs, sitemaps).
# Set this to the real production domain in Vercel's Project Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=https://waschbar.eu

# Supabase project storing voucher/lead signups (server-only, never exposed to the client).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email (server-only).
RESEND_API_KEY=
LEAD_FROM_EMAIL=Waschbar <anfrage@forms.example.com>
LEAD_TO_EMAIL=team@example.com
