# Public frontend values. These are safe to expose in the browser.
NEXT_PUBLIC_SITE_URL=https://www.waschbar.eu
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_LEAD_CAPTURE_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/voucher-lead

# Supabase Edge Function secrets. Set these with `supabase secrets set`, not in Vercel.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# The voucher-lead Edge Function hard-codes the Waschbar sender and abo@waschbar.eu recipient
# so shared Supabase project secrets from other sites cannot affect lead routing.
CONSENT_IP_HASH_SALT=
